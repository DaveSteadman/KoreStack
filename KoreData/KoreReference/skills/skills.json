{
  "schema_version": 1,
  "service": "korereference",
  "service_label": "KoreReference",
  "skills": [
    {
      "name": "korereference_search",
      "purpose": "Search KoreReference articles.",
      "keywords": [
        "reference",
        "article",
        "search"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 20
          },
          "offset": {
            "type": "integer",
            "default": 0
          }
        }
      },
      "returns": "Matching reference articles.",
      "invoke_path": "/api/skills/korereference_search/invoke",
      "selection_description": "Search KoreReference articles."
    },
    {
      "name": "korereference_articles_list",
      "purpose": "List KoreReference article metadata.",
      "keywords": [
        "reference",
        "article",
        "list"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 100
          },
          "offset": {
            "type": "integer",
            "default": 0
          }
        }
      },
      "returns": "A page of reference article metadata.",
      "invoke_path": "/api/skills/korereference_articles_list/invoke",
      "selection_description": "List KoreReference article metadata."
    },
    {
      "name": "korereference_article_get",
      "purpose": "Get a KoreReference article by title.",
      "keywords": [
        "reference",
        "article",
        "read"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "returns": "The requested reference article.",
      "invoke_path": "/api/skills/korereference_article_get/invoke",
      "selection_description": "Get a KoreReference article by title."
    }
  ]
}

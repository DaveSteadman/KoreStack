    {
      "name": "koredata_search",
      "purpose": "Search across KoreData collections and return structured results.",
      "keywords": [
        "dataset",
        "search",
        "research",
        "koredata"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "since": {
            "type": "string"
          },
          "until": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 20
          }
        },
        "required": [
          "query"
        ]
      },
      "returns": "Cross-collection search results.",
      "invoke_path": "/api/skills/koredata_search/invoke",
      "selection_description": "Search across KoreData collections and return structured results."
    },
